# ── Server ───────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
TRUST_PROXY=false

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://bloom:bloom@localhost:5432/bloom_dev
PGSSL=false
PG_POOL_MAX=10
PG_IDLE_TIMEOUT_MS=30000
PG_CONN_TIMEOUT_MS=10000

# ── Redis (optional — used for session store / advanced rate limiting) ─────────
REDIS_URL=redis://localhost:6379

# ── Auth ──────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_ME_generate_a_64_char_random_hex_string
JWT_REFRESH_SECRET=CHANGE_ME_different_64_char_random_hex_string
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
BCRYPT_ROUNDS=12

# ── AI (Claude) ───────────────────────────────────────────────────────────────
# Never commit a real key
ANTHROPIC_API_KEY=sk-ant-CHANGE_ME
CLAUDE_MODEL=claude-fable-5
CLAUDE_MAX_TOKENS=2048

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins. Leave empty to allow all (dev only).
CORS_ORIGIN=http://localhost:8081,http://localhost:19006

# ── Cron jobs ─────────────────────────────────────────────────────────────────
ENABLE_CRON=true

# ── Error tracking (Sentry) ───────────────────────────────────────────────────
# Get DSN from https://sentry.io → leave blank to disable
SENTRY_DSN=

# ── Cloudflare R2 (media storage) ─────────────────────────────────────────────
R2_ACCOUNT_ID=CHANGE_ME
R2_ACCESS_KEY_ID=CHANGE_ME
R2_SECRET_ACCESS_KEY=CHANGE_ME
R2_BUCKET=bloom-media
R2_PUBLIC_URL=https://media.bloompregnancy.app
MAX_UPLOAD_BYTES=10485760

# ── S3/R2 backups ─────────────────────────────────────────────────────────────
# Can reuse R2 with a separate bucket
BACKUP_S3_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
BACKUP_S3_REGION=auto
BACKUP_S3_BUCKET=bloom-backups
BACKUP_S3_ACCESS_KEY=CHANGE_ME
BACKUP_S3_SECRET_KEY=CHANGE_ME

# ── Push notifications ────────────────────────────────────────────────────────
EXPO_ACCESS_TOKEN=CHANGE_ME

# ── Rate limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_AI_MAX=30
