# ── Backend ──────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bloom
PGSSL=false
PG_POOL_MAX=10

# Auth (JWT)
JWT_SECRET=change-me-to-a-long-random-string
JWT_REFRESH_SECRET=change-me-to-another-long-random-string
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Anthropic Claude API
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxx
ANTHROPIC_MODEL=claude-opus-4-8

# CORS (comma-separated origins, or *)
CORS_ORIGIN=*

# Background jobs
ENABLE_CRON=true
SYMPTOM_JOB_CRON=0 6 * * 1

# Content generation (build-time)
CONTENT_LANGUAGES=English
CONTENT_TRACK=standard

# ── Mobile (Expo) ────────────────────────────────────────────────────────────
# Set this in mobile/app.json -> expo.extra.apiBaseUrl, or override at build time.
EXPO_PUBLIC_API_BASE_URL=http://localhost:4000/api
